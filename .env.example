# ==============================================================================
# ZERO-DOLLAR FACELESS YOUTUBE CREW CONFIGURATION
# All tools below offer 100% FREE tiers (no credit card required).
# ==============================================================================

# 1. LLM Engine (Free Tier from Google AI Studio or Groq)
# Get free Gemini API key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Groq free tier API key (fallback / alternative)
GROQ_API_KEY=your_groq_api_key_here

# 2. WhatsApp Notification Service (100% FREE - CallMeBot)
# Setup in 30 seconds:
# - Add phone +34 644 10 55 84 to your WhatsApp contacts
# - Send message "I allow callmebot to send me messages"
# - Receive your free API key in WhatsApp reply
WHATSAPP_PHONE=+1234567890
CALLMEBOT_API_KEY=your_callmebot_api_key_here

# Optional Alternative: Twilio Sandbox for WhatsApp (Free trial)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_WHATSAPP=whatsapp:+14155238886
TWILIO_TO_WHATSAPP=whatsapp:+1234567890

# 3. Channel Settings
TARGET_NICHE=Tech Innovations & AI Productivity
VIDEO_DURATION_MINUTES=8
VOICE_MODEL=en-US-ChristopherNeural
